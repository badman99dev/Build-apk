<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ M3U8 Extractor"
            android:textColor="#e6edf3"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/imdbInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="IMDb ID (e.g. tt0427340)"
                android:textColorHint="#30363d"
                android:textColor="#e6edf3"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:singleLine="true"
                android:inputType="text"
                android:textSize="15sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/extractBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Extract"
                android:background="@drawable/btn_bg"
                android:textColor="#fff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressTint="#7c3aed"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/langSpinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_bg"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/resultBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111119"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M3U8 URL"
                android:textColor="#7c3aed"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/m3u8Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#3fb950"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:background="#0a0a0f"
                android:maxLines="3"
                android:ellipsize="middle"
                android:textIsSelectable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/copyBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📋 Copy"
                    android:background="@drawable/btn_bg"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/playBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="▶ Play"
                    android:background="@drawable/btn_play_bg"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone"
            android:background="#000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logs"
            android:textColor="#484f58"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0d0d14"
            android:padding="8dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#6e7681"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp" />
        </ScrollView>

    </LinearLayout>

</LinearLayout>
